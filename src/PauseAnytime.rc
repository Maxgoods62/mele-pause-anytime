// The version info and the fonts compiled into LE<n>PauseAnytime.asi. Edit it as text: Visual Studio's resource editor
// would rewrite the #include lines and the macros.

#include <windows.h>
#include "SharedVersion.h"
#include "Resources.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_RC
 PRODUCTVERSION APP_VERSION_RC
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", DEVELOPER_A
            VALUE "FileDescription", ASI_DESCRIPTION
            VALUE "FileVersion", VERSION_STRING_RC
            VALUE "InternalName", GAME_PREFIX_RC ASI_NAME_NO_SPACE_A
            VALUE "OriginalFilename", GAME_PREFIX_RC ASI_NAME_NO_SPACE_A ".asi"
            VALUE "ProductName", ASI_NAME_A
            VALUE "ProductVersion", VERSION_STRING_RC
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

PAUSEANYTIME_FONT_REGULAR RCDATA "fonts/Exo2-Regular.ttf"
PAUSEANYTIME_FONT_SEMIBOLD RCDATA "fonts/Exo2-SemiBold.ttf"
