# Copy to build.env (not in git) and set what differs on your machine; every line is optional, and a variable already
# set in the environment wins over this file. A Windows path for MELE_LE_DIR; WSL paths for the others.
# MELE_LE_DIR='C:\Program Files (x86)\Steam\steamapps\common\Mass Effect Legendary Edition'   # default: from the registry
# MELE_VS='/mnt/c/Program Files (x86)/Microsoft Visual Studio/18/BuildTools'                 # default: VS 18, from vswhere
# MELE_LEXASIS='/mnt/c/Users/<you>/AppData/Local/mele-asi-build/MelePause/LExASIs'           # on the Windows disk
# MELE_STAGE='/mnt/c/<somewhere>/mele-pause'                                                 # default: dist/ here
